{
  "rewrites": [
    {
      "source": "/revision",
      "destination": "/index.html"
    },
    {
      "source": "/sandbox",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/**",
      "destination": "/index.html"
    },
    {
      "source": "/auth/**",
      "destination": "/index.html"
    },
    {
      "source": "/diagnostic/**",
      "destination": "/index.html"
    },
    {
      "source": "/my-results",
      "destination": "/index.html"
    },
    {
      "source": "/syllabus",
      "destination": "/index.html"
    },
    {
      "source": "/syllabus/**",
      "destination": "/index.html"
    },
    {
      "source": "/interactive/**",
      "destination": "/index.html"
    },
    {
      "source": "/questions/**",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "**",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    }
  ]
}
